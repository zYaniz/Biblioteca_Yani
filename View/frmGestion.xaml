<Window x:Class="SistemaGestiónBiblioteca_Yani.View.frmGestion"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SistemaGestiónBiblioteca_Yani.View"
        mc:Ignorable="d"
        Title="frmGestion" 
        Height="600" Width="850"
        AllowsTransparency="True"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="Transparent">

    <Window.Resources>
        <Style TargetType="TextBox" x:Key="PlaceholderStyle">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border BorderBrush="#004F59" BorderThickness="2" CornerRadius="5">
                            <Grid>
                                <Border Background="Transparent" />
                                <ScrollViewer x:Name="PART_ContentHost" />
                                <TextBlock x:Name="Placeholder" 
                                       Text="{Binding Path=Tag, RelativeSource={RelativeSource AncestorType=TextBox}}" 
                                       Foreground="Gray"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Left"
                                       Margin="5,0,0,0"
                                       Visibility="Collapsed"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="Text" Value=""/>
                                    <Condition Property="IsFocused" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Border Background="#FFEADEA4"
                CornerRadius="20"/>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="90"/>
                <RowDefinition Height="110"/>
                <RowDefinition Height="110"/>
                <RowDefinition Height="110"/>
                <RowDefinition Height="110"/>
                <RowDefinition/>

            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="45"/>
                <ColumnDefinition Width="130"/>
                <ColumnDefinition Width="230"/>
                <ColumnDefinition Width="230"/>
                <ColumnDefinition Width="230"/>

            </Grid.ColumnDefinitions>
            <Rectangle Grid.Row="0" Grid.Column="0" Fill="#004F59"/>
            <Rectangle Grid.Row="1" Grid.Column="0" Fill="#004F59"/>
            <Rectangle Grid.Row="2" Grid.Column="0" Fill="#004F59"/>
            <Rectangle Grid.Row="3" Grid.Column="0" Fill="#004F59"/>
            <Rectangle Grid.Row="4" Grid.Column="0" Fill="#004F59"/>
            <Rectangle Grid.Row="5" Grid.Column="0" Fill="#004F59"/>
            <Rectangle Grid.Row="0" Grid.Column="1" Fill="#004F59"/>
            <Rectangle Grid.Row="0" Grid.Column="2" Fill="#004F59"/>
            <Rectangle Grid.Row="0" Grid.Column="3" Fill="#004F59"/>
            <Rectangle Grid.Row="0" Grid.Column="4" Fill="#004F59"/>
            <Rectangle Grid.Row="1" Grid.Column="1" Fill="#004F59"/>
            <Rectangle Grid.Row="2" Grid.Column="1" Fill="#004F59"/>
            <Rectangle Grid.Row="3" Grid.Column="1" Fill="#004F59"/>
            <Rectangle Grid.Row="4" Grid.Column="1" Fill="#004F59"/>
            <Rectangle Grid.Row="5" Grid.Column="1" Fill="#004F59"/>

            <Border Grid.Column="0" BorderBrush="#f18a00">
                <Border.BorderThickness>
                    <Thickness Bottom="3" />
                </Border.BorderThickness>
            </Border>

            <Border Grid.Column="1" BorderBrush="#f18a00">
                <Border.BorderThickness>
                    <Thickness Bottom="3" />
                </Border.BorderThickness>
            </Border>

            <Border Grid.Column="2" BorderBrush="#f18a00">
                <Border.BorderThickness>
                    <Thickness Bottom="3" />
                </Border.BorderThickness>
            </Border>

            <Border Grid.Column="3" BorderBrush="#f18a00">
                <Border.BorderThickness>
                    <Thickness Bottom="3" />
                </Border.BorderThickness>
            </Border>

            <Border Grid.Row="1" Grid.Column="1" BorderBrush="#f18a00">
                <Border.BorderThickness>
                    <Thickness Right="3" />
                </Border.BorderThickness>
            </Border>

            <Border Grid.Row="0" Grid.Column="5" BorderBrush="#f18a00">
                <Border.BorderThickness>
                    <Thickness Bottom="3" />
                </Border.BorderThickness>
            </Border>

            <Border Grid.Row="2" Grid.Column="1" BorderBrush="#f18a00">
                <Border.BorderThickness>
                    <Thickness Right="3" />
                </Border.BorderThickness>
            </Border>

            <Border Grid.Row="3" Grid.Column="1" BorderBrush="#f18a00">
                <Border.BorderThickness>
                    <Thickness Right="3" />
                </Border.BorderThickness>
            </Border>

            <Border Grid.Row="4" Grid.Column="1" BorderBrush="#f18a00">
                <Border.BorderThickness>
                    <Thickness Right="3" />
                </Border.BorderThickness>
            </Border>

            <Border Grid.Row="5" Grid.Column="1" BorderBrush="#f18a00">
                <Border.BorderThickness>
                    <Thickness Right="3" />
                </Border.BorderThickness>
            </Border>


            <Label Grid.ColumnSpan="2" Grid.Column="1"  
               FontSize="42"  Content="Biblioteca YSF"
               HorizontalAlignment="Left" VerticalAlignment="Center"
               FontFamily="AR CHRISTY" Foreground="#FFE4DFDF"/>

            <Button x:Name="btnUsuario" Content="Usuario" FontSize="23" Width="120" Height="40"
                    Grid.Row="2" Grid.Column="1"
                    VerticalAlignment="Bottom" HorizontalAlignment="Left"
                    Background="#FFFFFCD8"
                    BorderBrush="#FF111915" BorderThickness="2" FontFamily="AR JULIAN" Click="btnUsuario_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <Border Grid.Row="2" Width="40" Height="40" HorizontalAlignment="Right" VerticalAlignment="Bottom" >
                <Border.Background>
                    <ImageBrush ImageSource="/Imagenes/usuario_icon.png"
                                Stretch="Fill"/>
                </Border.Background>
            </Border>

            <Button x:Name="btnLibro" Content="Libros" FontSize="23" Width="120" Height="40"
                    Grid.Row="3" Grid.Column="1"
                    VerticalAlignment="Bottom" HorizontalAlignment="Left"
                    Background="#FFFFFCD8"
                    BorderBrush="#FF111915" BorderThickness="2" FontFamily="AR JULIAN" Click="btnLibro_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <Border Grid.Row="3" Width="40" Height="40" HorizontalAlignment="Right" VerticalAlignment="Bottom" >
                <Border.Background>
                    <ImageBrush ImageSource="/Imagenes/libro_icon.png"
                                Stretch="Fill"/>
                </Border.Background>
            </Border>

            <Button x:Name="btnInicio" Content="Inicio" FontSize="23" Width="120" Height="40"
                    Grid.Row="1" Grid.Column="1"
                    VerticalAlignment="Bottom" HorizontalAlignment="Left"
                    Background="#FFFFFCD8"
                    BorderBrush="#FF111915" BorderThickness="2" FontFamily="AR JULIAN" Click="btnInicio_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <Border Grid.Row="1" Width="40" Height="40" HorizontalAlignment="Right" VerticalAlignment="Bottom" >
                <Border.Background>
                    <ImageBrush ImageSource="/Imagenes/home_icon.png"
                                Stretch="Fill"/>
                </Border.Background>
            </Border>


            <Button x:Name="btnCerrar" Content="Cerrar" FontSize="23" Width="120" Height="40"
                    Grid.Row="4" Grid.Column="1"
                    VerticalAlignment="Bottom" HorizontalAlignment="Left"
                    Background="#FFFFFCD8"
                    BorderBrush="#FF111915" BorderThickness="2" FontFamily="AR JULIAN" Click="btnCerrar_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <Border Grid.Row="4" Width="40" Height="40" HorizontalAlignment="Right" VerticalAlignment="Bottom" >
                <Border.Background>
                    <ImageBrush ImageSource="/Imagenes/logout_icon.png"
                                Stretch="Fill"/>
                </Border.Background>
            </Border>

            <Button x:Name="btnSolicitar" Content="Solicitar" FontSize="30"
                    Height="60" Width="150"
                    Grid.Row="1" Grid.Column="2" 
                    HorizontalAlignment="Center" VerticalAlignment="Bottom"
                    Background="Transparent" BorderThickness="3"
                    FontFamily="Book Antiqua" FontWeight="Bold" BorderBrush="#FF3C6D04" Click="btnSolicitar_Click" >
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <Button Content="Gestión" FontSize="30"
                    Height="60" Width="160"
                    Grid.Row="1" Grid.Column="3"
                    HorizontalAlignment="Center" VerticalAlignment="Bottom"
                    Background="Transparent" BorderThickness="3"
                    FontFamily="Book Antiqua" FontWeight="Bold" BorderBrush="White">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <Button x:Name="btnDevolucion" Content="Devolución" FontSize="30"
                    Height="60" Width="180"
                    Grid.Row="1" Grid.Column="4" 
                    HorizontalAlignment="Center" VerticalAlignment="Bottom"
                    Background="Transparent" BorderThickness="3"
                    FontFamily="Book Antiqua" FontWeight="Bold" BorderBrush="#FF3C6D04" Click="btnDevolucion_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <TextBox Grid.Row="2" Grid.Column="3" 
             FontSize="20"
             Style="{StaticResource PlaceholderStyle}"
             VerticalAlignment="Center" HorizontalAlignment="Center"
             Width="180" Height="40" 
             Tag="Ingrese Cédula"/>

            <ListBox Grid.Row="3" Grid.Column="3" Grid.RowSpan="2" 
                     Background="#FF80E4BD" BorderBrush="#FF000208"/>

            <Button x:Name="btnAceptar" Content="Aceptar" FontSize="25"
                    Height="45" Width="140"
                    Grid.Row="5" Grid.Column="2" 
                    HorizontalAlignment="Right" VerticalAlignment="Center"
                    Background="#FF7F80CC" BorderThickness="3"
                    FontFamily="Book Antiqua" FontWeight="Bold" BorderBrush="#FF3A3636" Click="btnAceptar_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <Button x:Name="btnRechazar" Content="Rechazar" FontSize="25"
                    Height="45" Width="140"
                    Grid.Row="5" Grid.Column="4" 
                    HorizontalAlignment="Left" VerticalAlignment="Center"
                    Background="#FFCE6A44" BorderThickness="3"
                    FontFamily="Book Antiqua" FontWeight="Bold" BorderBrush="#FF3A3636" Click="btnRechazar_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>

        </Grid>
    </Grid>
</Window>
