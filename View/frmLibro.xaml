<Window x:Class="SistemaGestiónBiblioteca_Yani.View.frmLibro"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SistemaGestiónBiblioteca_Yani.View"
        mc:Ignorable="d"
        Title="frmLibro" 
        Height="600" Width="850"
        AllowsTransparency="True"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="Transparent">

    <Window.Resources>
        <Style TargetType="TextBox" x:Key="PlaceholderStyle">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border BorderBrush="#004F59" BorderThickness="2" CornerRadius="5">
                            <Grid>
                                <Border Background="Transparent" />
                                <ScrollViewer x:Name="PART_ContentHost" />
                                <TextBlock x:Name="Placeholder" 
                                       Text="{Binding Path=Tag, RelativeSource={RelativeSource AncestorType=TextBox}}" 
                                       Foreground="Gray"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Left"
                                       Margin="5,0,0,0"
                                       Visibility="Collapsed"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="Text" Value=""/>
                                    <Condition Property="IsFocused" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Border Background="#FFEADEA4"
                CornerRadius="20"/>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="90"/>
                <RowDefinition Height="110"/>
                <RowDefinition Height="110"/>
                <RowDefinition Height="110"/>
                <RowDefinition Height="110"/>
                <RowDefinition/>

            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="45"/>
                <ColumnDefinition Width="130"/>
                <ColumnDefinition Width="230"/>
                <ColumnDefinition Width="230"/>
                <ColumnDefinition Width="230"/>

            </Grid.ColumnDefinitions>
            <Rectangle Grid.Row="0" Grid.Column="0" Fill="#004F59"/>
            <Rectangle Grid.Row="1" Grid.Column="0" Fill="#004F59"/>
            <Rectangle Grid.Row="2" Grid.Column="0" Fill="#004F59"/>
            <Rectangle Grid.Row="3" Grid.Column="0" Fill="#004F59"/>
            <Rectangle Grid.Row="4" Grid.Column="0" Fill="#004F59"/>
            <Rectangle Grid.Row="5" Grid.Column="0" Fill="#004F59"/>
            <Rectangle Grid.Row="0" Grid.Column="1" Fill="#004F59"/>
            <Rectangle Grid.Row="0" Grid.Column="2" Fill="#004F59"/>
            <Rectangle Grid.Row="0" Grid.Column="3" Fill="#004F59"/>
            <Rectangle Grid.Row="0" Grid.Column="4" Fill="#004F59"/>
            <Rectangle Grid.Row="1" Grid.Column="1" Fill="#004F59"/>
            <Rectangle Grid.Row="2" Grid.Column="1" Fill="#004F59"/>
            <Rectangle Grid.Row="3" Grid.Column="1" Fill="#004F59"/>
            <Rectangle Grid.Row="4" Grid.Column="1" Fill="#004F59"/>
            <Rectangle Grid.Row="5" Grid.Column="1" Fill="#004F59"/>

            <Border Grid.Column="0" BorderBrush="#f18a00">
                <Border.BorderThickness>
                    <Thickness Bottom="3" />
                </Border.BorderThickness>
            </Border>

            <Border Grid.Column="1" BorderBrush="#f18a00">
                <Border.BorderThickness>
                    <Thickness Bottom="3" />
                </Border.BorderThickness>
            </Border>

            <Border Grid.Column="2" BorderBrush="#f18a00">
                <Border.BorderThickness>
                    <Thickness Bottom="3" />
                </Border.BorderThickness>
            </Border>

            <Border Grid.Column="3" BorderBrush="#f18a00">
                <Border.BorderThickness>
                    <Thickness Bottom="3" />
                </Border.BorderThickness>
            </Border>

            <Border Grid.Row="1" Grid.Column="1" BorderBrush="#f18a00">
                <Border.BorderThickness>
                    <Thickness Right="3" />
                </Border.BorderThickness>
            </Border>

            <Border Grid.Row="0" Grid.Column="5" BorderBrush="#f18a00">
                <Border.BorderThickness>
                    <Thickness Bottom="3" />
                </Border.BorderThickness>
            </Border>

            <Border Grid.Row="2" Grid.Column="1" BorderBrush="#f18a00">
                <Border.BorderThickness>
                    <Thickness Right="3" />
                </Border.BorderThickness>
            </Border>

            <Border Grid.Row="3" Grid.Column="1" BorderBrush="#f18a00">
                <Border.BorderThickness>
                    <Thickness Right="3" />
                </Border.BorderThickness>
            </Border>

            <Border Grid.Row="4" Grid.Column="1" BorderBrush="#f18a00">
                <Border.BorderThickness>
                    <Thickness Right="3" />
                </Border.BorderThickness>
            </Border>

            <Border Grid.Row="5" Grid.Column="1" BorderBrush="#f18a00">
                <Border.BorderThickness>
                    <Thickness Right="3" />
                </Border.BorderThickness>
            </Border>


            <Label Grid.ColumnSpan="2" Grid.Column="1"  
               FontSize="42"  Content="Biblioteca YSF"
               HorizontalAlignment="Left" VerticalAlignment="Center"
               FontFamily="AR CHRISTY" Foreground="#FFE4DFDF" />

            <Button x:Name="btnUsuario" Content="Usuario" FontSize="23" Width="120" Height="40"
                    Grid.Row="2" Grid.Column="1"
                    VerticalAlignment="Bottom" HorizontalAlignment="Left"
                    Background="#FFFFFCD8"
                    BorderBrush="#FF111915" BorderThickness="2" FontFamily="AR JULIAN" Click="btnUsuario_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <Border Grid.Row="2" Width="40" Height="40" HorizontalAlignment="Right" VerticalAlignment="Bottom" >
                <Border.Background>
                    <ImageBrush ImageSource="/Imagenes/usuario_icon.png"
                                Stretch="Fill"/>
                </Border.Background>
            </Border>

            <Button x:Name="btnInicio" Content="Inicio" FontSize="23" Width="120" Height="40"
                    Grid.Row="1" Grid.Column="1"
                    VerticalAlignment="Bottom" HorizontalAlignment="Left"
                    Background="#FFFFFCD8"
                    BorderBrush="#FF111915" BorderThickness="2" FontFamily="AR JULIAN" Click="btnInicio_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <Border Grid.Row="1" Width="40" Height="40" HorizontalAlignment="Right" VerticalAlignment="Bottom" >
                <Border.Background>
                    <ImageBrush ImageSource="/Imagenes/home_icon.png"
                                Stretch="Fill"/>
                </Border.Background>
            </Border>

            <Button x:Name="btnPrestamo" Content="Préstamo" FontSize="23" Width="120" Height="40"
                    Grid.Row="3" Grid.Column="1"
                    VerticalAlignment="Bottom" HorizontalAlignment="Left"
                    Background="#FFFFFCD8"
                    BorderBrush="#FF111915" BorderThickness="2" FontFamily="AR JULIAN" Click="btnPrestamo_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <Border Grid.Row="3" Width="40" Height="40" HorizontalAlignment="Right" VerticalAlignment="Bottom" >
                <Border.Background>
                    <ImageBrush ImageSource="/Imagenes/prestamo_icon.png"
                                Stretch="Fill"/>
                </Border.Background>
            </Border>


            <Button x:Name="btnCerrar" Content="Cerrar" FontSize="23" Width="120" Height="40"
                    Grid.Row="4" Grid.Column="1"
                    VerticalAlignment="Bottom" HorizontalAlignment="Left"
                    Background="#FFFFFCD8"
                    BorderBrush="#FF111915" BorderThickness="2" FontFamily="AR JULIAN" Click="btnCerrar_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <Border Grid.Row="4" Width="40" Height="40" HorizontalAlignment="Right" VerticalAlignment="Bottom" >
                <Border.Background>
                    <ImageBrush ImageSource="/Imagenes/logout_icon.png"
                                Stretch="Fill"/>
                </Border.Background>
            </Border>

            <Button Content="Registrar" FontSize="30"
                    Height="60" Width="150"
                    Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2" 
                    HorizontalAlignment="Right" VerticalAlignment="Top"
                    Background="Transparent" BorderThickness="3"
                    FontFamily="Book Antiqua" FontWeight="Bold" BorderBrush="White" Margin="0,50,155,0">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <Button x:Name="btnBuscar" Content="Buscar" FontSize="30"
                    Height="60" Width="140"
                    Grid.Row="1" Grid.Column="3" Grid.ColumnSpan="2"
                    HorizontalAlignment="Center" VerticalAlignment="Bottom"
                    Background="Transparent" BorderThickness="3"
                    FontFamily="Book Antiqua" FontWeight="Bold" BorderBrush="#FF3C6D04" Click="btnBuscar_Click" 
                    >
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>


            <TextBox x:Name="txtTitulo" Grid.Row="3" Grid.Column="2" 
             FontSize="20"
             Style="{StaticResource PlaceholderStyle}"
             VerticalAlignment="Top" HorizontalAlignment="Right"
             Width="180" Height="40" 
             Tag="Ingrese Título" />

            <TextBox x:Name="txtAutor" Grid.Row="3" Grid.Column="4" 
             FontSize="20"
             Style="{StaticResource PlaceholderStyle}"
             VerticalAlignment="Top" HorizontalAlignment="Left"
             Width="180" Height="40" 
             Tag="Ingrese Autor" />

            <TextBox x:Name="txtISBN" Grid.Row="4" Grid.Column="4" 
             FontSize="20"
             Style="{StaticResource PlaceholderStyle}"
             VerticalAlignment="Top" HorizontalAlignment="Left"
             Width="180" Height="40" 
             Tag="Ingrese ISBN"/>

            <TextBox x:Name="txtDisponibilidad" Grid.Row="4" Grid.Column="3" 
             FontSize="20"
             Style="{StaticResource PlaceholderStyle}"
             VerticalAlignment="Bottom" HorizontalAlignment="Center"
             Width="180" Height="40" 
             Tag="Ingrese Disponibilidad"/>

            <TextBox x:Name="txtFechaAdicion" Grid.Row="2" Grid.Column="4" 
             FontSize="20"
             Style="{StaticResource PlaceholderStyle}"
             VerticalAlignment="Center" HorizontalAlignment="Left"
             Width="150" Height="40"
            Tag="Fecha Adicion "/>


            <TextBox x:Name="txtAdicionadoPor" Grid.Row="2" Grid.Column="2" 
             FontSize="20"
             Style="{StaticResource PlaceholderStyle}"
             VerticalAlignment="Center" HorizontalAlignment="Right"
             Width="150" Height="40"
             Tag="Adicionado Por"/>

            <TextBox x:Name="txtCategoria" Grid.Row="4" Grid.Column="2" 
             FontSize="20"
             Style="{StaticResource PlaceholderStyle}"
             VerticalAlignment="Top" HorizontalAlignment="Right"
             Width="180" Height="40" 
             Tag="Ingrese Categoría"/>

            <Button x:Name="btnGuardar" Content="Guardar" FontSize="25"
                    Height="50" Width="140"
                    Grid.Row="5" Grid.Column="2" 
                    HorizontalAlignment="Right" VerticalAlignment="Top"
                    Background="#0099a8" BorderThickness="4"
                    FontFamily="Book Antiqua" FontWeight="Bold" BorderBrush="#FF3A3636" Click="btnGuardar_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <Button x:Name="btnLimpiar" Content="Limpiar" FontSize="25"
                    Height="55" Width="140"
                    Grid.Row="5" Grid.Column="4" 
                    HorizontalAlignment="Left" VerticalAlignment="Top"
                    Background="#FF74EA27" BorderThickness="4"
                    FontFamily="Book Antiqua" FontWeight="Bold" BorderBrush="#FF3A3636" Click="btnLimpiar_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <Border Grid.Row="3" Grid.Column="3"  Grid.RowSpan="3"
                Width="150" Height="150" 
                    HorizontalAlignment="Center" VerticalAlignment="Top" >
                <Border.Background>
                    <ImageBrush ImageSource="/Imagenes/book.png"
                                Stretch="Fill"/>
                </Border.Background>
            </Border>

        </Grid>
    </Grid>
</Window>
